{
  "name": "dbsgraphic/smart-support-chatbot",
  "description": "Professional AI assistant for WordPress with modular architecture and pharmaceutical PV extension.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "wp-coding-standards/wpcs": "^3.0",
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "test": ["php tests/unit.php", "node --test tests/frontend.test.cjs"],
    "test:integration": "php tests/integration.php"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
