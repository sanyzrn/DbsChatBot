# Auto detect text files and perform LF normalization
* text=auto

# Force LF for source files so PHPCS (WordPress ruleset) passes on every OS,
# including Windows checkouts where autocrlf would otherwise write CRLF.
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.pot text eol=lf
*.po text eol=lf
*.sh text eol=lf

# Binary files — never normalize.
*.woff2 binary
*.woff binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
