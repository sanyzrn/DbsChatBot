# Composer (dev tooling only — the plugin itself has no runtime dependencies)
/vendor/

# Node (used only by the test runner; there is no build step)
/node_modules/

# Build output
/dist/

# Editors & OS
.idea/
.vscode/
*.sublime-*
.DS_Store
Thumbs.db
desktop.ini

# Marketplace licence file (belongs to the RTL-Theme product; never commit it)
RTL_License_*.php

# Local overrides & logs
*.log
.phpunit.result.cache
.phpcs-cache

# Python bytecode (tools/ and tests/ run with plain python)
__pycache__/
*.pyc
