<?xml version="1.0"?>
<ruleset name="SmartSupportChatbot">
    <description>PHP CodeSniffer ruleset برای افزونه دستیار هوشمند گفتگو</description>

    <!-- فایل‌های بررسی‌شونده -->
    <file>smart-support-chatbot</file>

    <!-- استثناها -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*\.min\.js$</exclude-pattern>
    <!-- فایل‌های JS (phpcs نباید آن‌ها را بررسی کند) -->
    <exclude-pattern>*/assets/js/*</exclude-pattern>
    <exclude-pattern>*/blocks/*/*.js</exclude-pattern>

    <!-- استاندارد اصلی وردپرس -->
    <rule ref="WordPress">
        <exclude name="WordPress.Arrays.MultipleStatementAlignment"/>
    </rule>

    <!-- فایل‌های view متغیرهای قالبی (غیر‌global) دارند — prefix لازم نیست -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>*/views/*</exclude-pattern>
    </rule>

    <!-- جدول‌های افزونه مستقیم کوئری می‌زنند — این عمدی است -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <exclude-pattern>*/class-smart-support-chatbot-db.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL.InterpolatedNotPrepared">
        <exclude-pattern>*/class-smart-support-chatbot-db.php</exclude-pattern>
    </rule>

    <!--
      نام فایل کلاس‌ها عمداً از اسلاگ کامل افزونه (smart-support-chatbot-*) پیروی می‌کند
      نه از پیش‌وند کوتاه کلاس (SSC_*) — برای یکدستی با نام دارایی‌ها/آدرس‌ها.
      index.asset.php هم پسوند اجباری wp-scripts برای مانیفست وابستگی بلوک است.
    -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>*/includes/*.php</exclude-pattern>
        <exclude-pattern>*/widgets/*.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>*/blocks/*/index.asset.php</exclude-pattern>
    </rule>

    <!-- حداقل نسخه PHP -->
    <config name="minimum_supported_wp_version" value="5.9"/>
    <config name="testVersion" value="7.4-"/>

    <!-- پیش‌وند متغیر افزونه (حداقل ۴ کاراکتر لازم است) -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="ssc_chatbot"/>
                <element value="SSC_CHATBOT"/>
                <element value="SSC_Chatbot"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="smart-support-chatbot"/>
            </property>
        </properties>
    </rule>
</ruleset>
